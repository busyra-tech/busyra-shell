<Page
    x:Class="DjieShell.Views.HostsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Hosts" FontSize="28" FontWeight="Bold" />
                <TextBlock x:Name="Subtitle" Opacity="0.6" />
            </StackPanel>
            <AutoSuggestBox x:Name="Search" Grid.Column="1" PlaceholderText="Cari host…" QueryIcon="Find"
                            VerticalAlignment="Center" TextChanged="Search_TextChanged" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="Add_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Text="Host baru" />
                </StackPanel>
            </Button>
        </Grid>
        <ScrollViewer Grid.Row="1">
            <Grid>
                <ItemsRepeater x:Name="Cards">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="260" MinItemHeight="128" MinRowSpacing="14"
                                           MinColumnSpacing="14" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
                <StackPanel x:Name="Empty" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,90,0,0" Spacing="10">
                    <FontIcon Glyph="&#xE968;" FontSize="44" Foreground="{StaticResource DjieGradient}" />
                    <TextBlock Text="Belum ada host" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Tambahkan server pertamamu — tersimpan terenkripsi di vault." Opacity="0.6" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
