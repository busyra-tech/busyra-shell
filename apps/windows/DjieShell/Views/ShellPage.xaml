<Page
    x:Class="DjieShell.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <NavigationView x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    PaneDisplayMode="Left" OpenPaneLength="230" SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="WORKSPACE" />
            <NavigationViewItem Content="Hosts" Tag="hosts" IsSelected="True">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE968;" Foreground="#3B82F6" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Keychain" Tag="keychain">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" Foreground="#F59E0B" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Port Forwarding" Tag="forwarding">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" Foreground="#10B981" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="SFTP" Tag="sftp">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" Foreground="#06B6D4" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Database" Tag="database">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE1D3;" Foreground="#F97316" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Snippets" Tag="snippets">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE943;" Foreground="#8B5CF6" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Logs" Tag="logs">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" Foreground="#64748B" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Kunci vault" Tag="lock">
                <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" Padding="28,8,28,20" />
    </NavigationView>
</Page>
