<Page
    x:Class="DjieShell.Views.LockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Latar gradien halus -->
        <Grid.Background>
            <RadialGradientBrush Center="0.35,0.25" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#2A3FD0B4" Offset="0" />
                <GradientStop Color="#109D7CF2" Offset="0.5" />
                <GradientStop Color="#00000000" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <StackPanel x:Name="Card" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Opacity="0">
            <Image Source="/Assets/logo.png" Width="84" Height="84" HorizontalAlignment="Center" />
            <TextBlock x:Name="Title" Text="Selamat datang di Djie Shell" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="Subtitle" Text="Semua servermu, satu terminal." FontFamily="Cascadia Mono, Consolas" Opacity="0.7" HorizontalAlignment="Center" />
            <PasswordBox x:Name="Password" PlaceholderText="Master password" Margin="0,18,0,0" KeyDown="Password_KeyDown" />
            <PasswordBox x:Name="Confirm" PlaceholderText="Ulangi password" Visibility="Collapsed" KeyDown="Password_KeyDown" />
            <Button x:Name="Submit" Content="Buka vault" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="Submit_Click" />
            <InfoBar x:Name="Error" Severity="Error" IsClosable="False" IsOpen="False" />
            <TextBlock x:Name="Hint" TextWrapping="Wrap" FontSize="12" Opacity="0.55" HorizontalAlignment="Center" TextAlignment="Center"
                       Text="Data host dienkripsi di perangkatmu (Argon2id + XChaCha20). Master password tidak bisa dipulihkan." />
        </StackPanel>
    </Grid>
</Page>
