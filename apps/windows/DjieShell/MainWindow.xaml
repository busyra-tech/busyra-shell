<Window
    x:Class="DjieShell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Djie Shell">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar khusus -->
        <Grid x:Name="TitleBar" Grid.Row="0" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="Assets/logo.png" Width="18" Height="18" />
                <TextBlock Text="Djie Shell" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="#243FD0B4" CornerRadius="8" Padding="6,1">
                    <TextBlock x:Name="VersionText" Text="0.1.0" FontSize="10" Foreground="{StaticResource DjieTeal}" />
                </Border>
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
